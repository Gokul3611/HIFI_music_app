<?xml version="1.0" encoding="utf-8"?>
<!-- The wide "Now playing" widget: 4x1 by default, resizable. No update period: the playback
     service pushes every change (NowPlayingWidgetFeed), so the widget never wakes the phone. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_now_playing_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="@dimen/widget_now_playing_min_width"
    android:minHeight="@dimen/widget_now_playing_min_height"
    android:minResizeWidth="@dimen/widget_now_playing_min_resize_width"
    android:minResizeHeight="@dimen/widget_now_playing_min_resize_height"
    android:maxResizeWidth="@dimen/widget_now_playing_max_resize_width"
    android:maxResizeHeight="@dimen/widget_now_playing_max_resize_height"
    android:previewImage="@drawable/widget_preview_wide_image"
    android:previewLayout="@layout/widget_preview_wide"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="@integer/widget_now_playing_target_cell_width"
    android:targetCellHeight="@integer/widget_now_playing_target_cell_height"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen|keyguard" />
